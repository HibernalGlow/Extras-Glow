{
    "version": "3.8.5",
    "description": "一款以隐私为首要原则、可自行托管且完全开源的个人知识管理软件 | A privacy-first, self-hosted, fully open source personal knowledge management software",
    "homepage": "https://b3log.org/siyuan",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/siyuan-note/siyuan/releases/download/v3.8.5/siyuan-3.8.5-win.exe#/dl.7z",
            "hash": "e0e664e2aff4a97f724265d403dea4e9d7d5cd3d1a00cd9e6cb315bfac699b90",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Force -Recurse"
            ]
        },
        "arm64": {
            "url": "https://github.com/siyuan-note/siyuan/releases/download/v3.8.5/siyuan-3.8.5-win-arm64.exe#/dl.7z",
            "hash": "2fc4de58292371e3b5dfac35d6d14780e2917ef0fc874f3e92c21a6274a9bde7",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Force -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "siyuan.exe",
            "SiYuan"
        ]
    ],
    "bin": [
        [
            "resources\\kernel\\SiYuan-Kernel.exe",
            "siyuan"
        ]
    ],
    "post_install": [
        "$links = @(",
        "    @(\"$env:USERPROFILE\\SiYuan\", \"$persist_dir\\SiYuan\"),",
        "    @(\"$env:APPDATA\\SiYuan-Electron\", \"$persist_dir\\AppData\\Roaming\\SiYuan-Electron\"),",
        "    @(\"$env:USERPROFILE\\.config\\siyuan\", \"$persist_dir\\.config\\siyuan\")",
        ")",
        "foreach ($l in $links) {",
        "    $link = $l[0]",
        "    $target = $l[1]",
        "    $item = Get-Item $link -Force -ErrorAction SilentlyContinue",
        "    if ($item -and $item.LinkType) {",
        "        if (([string]@($item.Target)[0]).TrimEnd('\\') -ieq $target.TrimEnd('\\')) { continue }",
        "        $item.Delete()",
        "        $item = $null",
        "    }",
        "    if (!(Test-Path $target)) {",
        "        if ($item -and !$item.LinkType) {",
        "            New-Item -ItemType Directory -Path (Split-Path $target -Parent) -Force | Out-Null",
        "            Move-Item -Path $item.FullName -Destination $target -Force",
        "        } else {",
        "            New-Item -ItemType Directory -Path $target -Force | Out-Null",
        "        }",
        "    } elseif ($item -and !$item.LinkType) {",
        "        if ((Get-ChildItem $item.FullName -Force -ErrorAction SilentlyContinue | Measure-Object).Count -gt 0) { throw \"'$link' still contains data, aborting to avoid loss\" }",
        "        $item.Delete()",
        "    }",
        "    New-Item -ItemType Directory -Path (Split-Path $link -Parent) -Force -ErrorAction SilentlyContinue | Out-Null",
        "    New-Item -ItemType Junction -Path $link -Target $target -Force | Out-Null",
        "    Write-Host \"Persisting (Junction) $link => $target\"",
        "}"
    ],
    "pre_uninstall": "Get-Process -Name 'SiYuan', 'SiYuan-Kernel' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
    "post_uninstall": [
        "$env:USERPROFILE\\SiYuan, $env:APPDATA\\SiYuan-Electron, $env:USERPROFILE\\.config\\siyuan | ForEach-Object {",
        "    $item = Get-Item $_ -Force -ErrorAction SilentlyContinue",
        "    if ($item -and $item.LinkType) {",
        "        Write-Host \"Removing junction $_\"",
        "        $item.Delete()",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/siyuan-note/siyuan"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/siyuan-note/siyuan/releases/download/v$version/siyuan-$version-win.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/siyuan-note/siyuan/releases/download/v$version/siyuan-$version-win-arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
