{
    "version": "1.3.0",
    "description": "Taix - 基于 Avalonia 与 Rust 构建的跨平台（Windows/macOS）软件与网站使用时长统计工具",
    "homepage": "https://github.com/NLick47/Taix",
    "license": "MIT",
    "url": "https://github.com/NLick47/Taix/releases/download/v1.3.0/Taix-1.3.0-win-x64.zip",
    "hash": "30CEE51A694C859FDB002F364F938396FF0FA3282B41E0F769E48C63B08DC5A8",
    "bin": "Taix.exe",
    "shortcuts": [
        [
            "Taix.exe",
            "Taix"
        ]
    ],
    "post_install": [
        "$shellExe = Join-Path $dir 'taix-shell.exe'",
        "$registered = $false",
        "# Try official scheduled-task registration (needs admin for HighestAvailable run level)",
        "$p = Start-Process -FilePath $shellExe -ArgumentList 'install' -WorkingDirectory $dir -Wait -PassThru -NoNewWindow",
        "if ($p.ExitCode -eq 0) { $registered = $true }",
        "# Fallback for non-admin: startup-folder shortcut for auto-launch",
        "if (-not $registered) {",
        "    $startup = [Environment]::GetFolderPath('Startup')",
        "    $ws = New-Object -ComObject WScript.Shell",
        "    $sc = $ws.CreateShortcut((Join-Path $startup 'TaixShell.lnk'))",
        "    $sc.TargetPath = $shellExe",
        "    $sc.WorkingDirectory = $dir",
        "    $sc.Save()",
        "    Write-Host '[taix] Auto-launch via startup shortcut (scheduled task needs admin; run \"taix-shell install\" as admin to upgrade)'",
        "} else {",
        "    Write-Host '[taix] TaixShell scheduled task registered'",
        "}",
        "# Start the watchdog now so the client can connect immediately",
        "Start-Process -FilePath $shellExe -WorkingDirectory $dir"
    ],
    "pre_uninstall": [
        "$shellExe = Join-Path $dir 'taix-shell.exe'",
        "if (Test-Path $shellExe) {",
        "    Start-Process -FilePath $shellExe -ArgumentList 'uninstall' -WorkingDirectory $dir -Wait -PassThru -NoNewWindow | Out-Null",
        "}",
        "$startup = [Environment]::GetFolderPath('Startup')",
        "Remove-Item (Join-Path $startup 'TaixShell.lnk') -Force -ErrorAction SilentlyContinue",
        "Get-Process -Name 'taix-shell','taix-server','taix-monitor-windows' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "github": "https://github.com/NLick47/Taix"
    },
    "autoupdate": {
        "url": "https://github.com/NLick47/Taix/releases/download/v$version/Taix-$version-win-x64.zip"
    }
}
