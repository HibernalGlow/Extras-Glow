{
    "version": "0.6.15",
    "description": "Immersive lyrics player for local music, Navidrome, and third-party NetEase Cloud Music",
    "homepage": "https://github.com/chthollyphile/folia-major",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/chthollyphile/folia-major/releases/download/v0.6.15/Folia-Setup-0.6.15.exe#/dl.7z",
            "hash": "e1d10755ddf63e62eea42512746174dc5067268bdce31f72f5887fb68ba69862"
        }
    },
    "pre_install": [
        "$payload = Join-Path \"$dir\\`$PLUGINSDIR\" 'app-64.7z'",
        "if (-not (Test-Path $payload -PathType Leaf)) { throw 'Folia application payload was not found in the NSIS package' }",
        "Expand-7zipArchive -Path $payload -DestinationPath $dir -Removal",
        "if (-not (Test-Path \"$dir\\Folia.exe\" -PathType Leaf)) { throw 'Folia.exe was not found after payload extraction' }",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "bin": "Folia.exe",
    "shortcuts": [
        [
            "Folia.exe",
            "Folia"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/chthollyphile/folia-major/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/chthollyphile/folia-major/releases/download/v$version/Folia-Setup-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/chthollyphile/folia-major/releases/tags/v$version",
            "jsonpath": "$.assets.[?(@name=='Folia-Setup-$version.exe')].digest"
        }
    }
}
