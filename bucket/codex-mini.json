{
    "version": "5.10.0",
    "description": "A lightweight desktop client for Codex and GPT Mini",
    "homepage": "https://github.com/CoimgRain/Codex-Mini",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/CoimgRain/Codex-Mini/releases/download/codex-mini-v5.10.0/GPTMini_v5.10.0_Windows_Setup.exe",
            "hash": "d4b0ba24a9f6b6584f2959f113f0a8604a649f57c979b6fda61ce057ec7c2a0b"
        }
    },
    "installer": {
        "script": [
            "Start-Process -FilePath \"$dir\\$fname\" -ArgumentList '/S'",
            "Start-Sleep -Seconds 5",
            "Remove-Item \"$dir\\$fname\" -Force",
            "$app = Get-Item \"$env:LOCALAPPDATA\\Programs\\GPT Mini\\GPT Mini.exe\" -ErrorAction SilentlyContinue",
            "if (!$app) { throw 'GPT Mini.exe was not found after installation.' }",
            "Set-Content -Path \"$dir\\GPT Mini.cmd\" -Value @('@echo off', ('start \"\" \"' + $app.FullName + '\" %*')) -Encoding ASCII"
        ]
    },
    "uninstaller": {
        "script": [
            "$uninstaller = Get-Item \"$env:LOCALAPPDATA\\Programs\\GPT Mini\\Uninstall GPT Mini.exe\" -ErrorAction SilentlyContinue",
            "if ($uninstaller) { Start-Process -FilePath $uninstaller.FullName -ArgumentList '/S' -Wait }"
        ]
    },
    "bin": "GPT Mini.cmd",
    "shortcuts": [
        [
            "GPT Mini.cmd",
            "Codex-Mini"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/CoimgRain/Codex-Mini/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "codex-mini-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CoimgRain/Codex-Mini/releases/download/codex-mini-v$version/GPTMini_v$version_Windows_Setup.exe"
            }
        }
    }
}
