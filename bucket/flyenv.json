{
    "version": "4.20.1",
    "description": "All-In-One Native Local Development Environment for Windows, macOS & Linux. Docker alternative for PHP, Node.js, Python and more",
    "homepage": "https://github.com/xpf0000/FlyEnv",
    "license": "BSD-3-Clause",
    "url": "https://github.com/xpf0000/FlyEnv/releases/download/v4.20.1/FlyEnv-Setup-4.20.1.exe",
    "hash": "02af4d3c318cbb4f3cd90d9c5dbc0555bda5990871957bbcb524293399d1463c",
    "depends": "7zip",
    "installer": {
        "script": [
            "# Extract the NSIS installer",
            "& 7z x \"$dir\\$fname\" -o\"$dir\" -y | Out-Null",
            "# Extract app-64.7z from $PLUGINSDIR",
            "$appArchive = Join-Path $dir '$PLUGINSDIR\\app-64.7z'",
            "if (Test-Path $appArchive) {",
            "    & 7z x $appArchive \"-o$dir\" -y | Out-Null",
            "    # Clean up",
            "    Remove-Item (Join-Path $dir '$PLUGINSDIR') -Recurse -Force -ErrorAction SilentlyContinue",
            "    Remove-Item (Join-Path $dir '$R0') -Recurse -Force -ErrorAction SilentlyContinue",
            "    Remove-Item \"$dir\\$fname\" -Force -ErrorAction SilentlyContinue",
            "} else {",
            "    Write-Error 'Failed to extract installer'",
            "}"
        ]
    },
    "bin": "FlyEnv.exe",
    "shortcuts": [
        [
            "FlyEnv.exe",
            "FlyEnv"
        ]
    ],
    "checkver": {
        "github": "https://github.com/xpf0000/FlyEnv"
    },
    "autoupdate": {
        "url": "https://github.com/xpf0000/FlyEnv/releases/download/v$version/FlyEnv-Setup-$version.exe"
    }
}
